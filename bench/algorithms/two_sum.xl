# LeetCode 1: Two Sum —— 哈希表，衡量 Map 的插入/查找开销。
def two_sum(a, target){
	var seen = {}
	for(var i = 0; i < len(a); i += 1){
		var need = target - a[i]
		var got = seen[need]
		if(got != none){
			return [got, i]
		}
		seen[a[i]] = i
	}
	return [-1, -1]
}

var n = 30000
var a = []
var seed = 13579
for(var i = 0; i < n; i += 1){
	seed = (seed * 1103515245 + 12345) % 2147483648
	a.append(seed % 1000000)
}

var total = 0
for(var r = 0; r < 80; r += 1){
	var target = a[r] + a[n - 1 - r]
	var pair = two_sum(a, target)
	total += pair[0] + pair[1]
}
total
