# LeetCode 912: Sort an Array —— 自顶向下归并排序。
def merge(a, tmp, lo, mid, hi){
	var i = lo
	var j = mid + 1
	var k = lo
	for(; i <= mid and j <= hi; ){
		if(a[i] <= a[j]){
			tmp[k] = a[i]
			i += 1
		}else{
			tmp[k] = a[j]
			j += 1
		}
		k += 1
	}
	for(; i <= mid; ){
		tmp[k] = a[i]
		i += 1
		k += 1
	}
	for(; j <= hi; ){
		tmp[k] = a[j]
		j += 1
		k += 1
	}
	for(var p = lo; p <= hi; p += 1){
		a[p] = tmp[p]
	}
	return 0
}

def msort(a, tmp, lo, hi){
	if(lo >= hi){
		return 0
	}
	var mid = int((lo + hi) / 2)
	msort(a, tmp, lo, mid)
	msort(a, tmp, mid + 1, hi)
	merge(a, tmp, lo, mid, hi)
	return 0
}

var n = 30000
var a = []
var tmp = []
var seed = 987654321
for(var i = 0; i < n; i += 1){
	seed = (seed * 1103515245 + 12345) % 2147483648
	a.append(seed % 100000)
	tmp.append(0)
}

msort(a, tmp, 0, n - 1)

var sorted = 1
var sum = 0
for(var i = 0; i < n; i += 1){
	if(i > 0 and a[i - 1] > a[i]){
		sorted = 0
	}
	sum += a[i]
}

[sorted, sum]
