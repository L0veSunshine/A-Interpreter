# LeetCode 1143: Longest Common Subsequence —— 二维 DP 展平成一维数组。
def lcs(s, t){
	var n = len(s)
	var m = len(t)
	var width = m + 1
	var dp = []
	for(var k = 0; k < (n + 1) * width; k += 1){
		dp.append(0)
	}
	for(var i = 1; i <= n; i += 1){
		var base = i * width
		var prev = base - width
		for(var j = 1; j <= m; j += 1){
			if(s[i - 1] == t[j - 1]){
				dp[base + j] = dp[prev + j - 1] + 1
			}else{
				var up = dp[prev + j]
				var left = dp[base + j - 1]
				if(up > left){
					dp[base + j] = up
				}else{
					dp[base + j] = left
				}
			}
		}
	}
	return dp[n * width + m]
}

var s = "abcdefghij"
var t = "jihgfedcbazyxwv"
for(var i = 0; i < 6; i += 1){
	s = s + s
	t = t + t
}

lcs(s, t)
