# LeetCode 912: Sort an Array —— 原地快速排序（Lomuto 分区）。
# 输入由固定 LCG 生成，保证两种语言拿到完全相同的数据。
def partition(a, lo, hi){
	var pivot = a[hi]
	var i = lo
	for(var j = lo; j < hi; j += 1){
		if(a[j] <= pivot){
			var t = a[i]
			a[i] = a[j]
			a[j] = t
			i += 1
		}
	}
	var t2 = a[i]
	a[i] = a[hi]
	a[hi] = t2
	return i
}

def qsort(a, lo, hi){
	if(lo >= hi){
		return 0
	}
	var p = partition(a, lo, hi)
	qsort(a, lo, p - 1)
	qsort(a, p + 1, hi)
	return 0
}

var n = 30000
var a = []
var seed = 12345
for(var i = 0; i < n; i += 1){
	seed = (seed * 1103515245 + 12345) % 2147483648
	a.append(seed % 100000)
}

qsort(a, 0, n - 1)

var sorted = 1
var sum = 0
for(var i = 0; i < n; i += 1){
	if(i > 0 and a[i - 1] > a[i]){
		sorted = 0
	}
	sum += a[i]
}

[sorted, sum]
