# LeetCode 912: Sort an Array —— 原地堆排序，衡量下沉（sift-down）与数组交换。
var n = 200000

def sift_down(a, start, end){
	var root = start
	for(; 2 * root + 1 <= end; ){
		var child = 2 * root + 1
		var swap = root
		if(a[swap] < a[child]){
			swap = child
		}
		if(child + 1 <= end and a[swap] < a[child + 1]){
			swap = child + 1
		}
		if(swap == root){
			return 0
		}
		var t = a[root]
		a[root] = a[swap]
		a[swap] = t
		root = swap
	}
	return 0
}

def heapsort(a){
	var size = len(a)
	for(var s = (size - 2) // 2; s >= 0; s -= 1){
		sift_down(a, s, size - 1)
	}
	for(var end = size - 1; end > 0; end -= 1){
		var t = a[0]
		a[0] = a[end]
		a[end] = t
		sift_down(a, 0, end - 1)
	}
	return 0
}

var a = []
var seed = 12345
for(var i = 0; i < n; i += 1){
	seed = (seed * 1103515245 + 12345) % 2147483648
	a.append(seed % 100000)
}

heapsort(a)

var ok = 1
var total = 0
for(var i = 0; i < n; i += 1){
	if(i > 0 and a[i - 1] > a[i]){
		ok = 0
	}
	total += a[i]
}
[ok, total]
