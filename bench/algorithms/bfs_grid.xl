# BFS 最短路：400×400 网格（25% 障碍，固定 LCG 生成），衡量队列与二维下标。
var R = 400
var C = 400
var seed = 2024
var wall = []
for(var i = 0; i < R * C; i += 1){
	seed = (seed * 1103515245 + 12345) % 2147483648
	if(seed % 100 < 25){
		wall.append(1)
	}else{
		wall.append(0)
	}
}
wall[0] = 0
wall[R * C - 1] = 0

var dist = []
for(var i = 0; i < R * C; i += 1){
	dist.append(-1)
}
dist[0] = 0
var queue = [0]
var head = 0
for(; head < len(queue); ){
	var cur = queue[head]
	head += 1
	var r = cur // C
	var c = cur % C
	var d = dist[cur] + 1
	if(r > 0 and wall[cur - C] == 0 and dist[cur - C] == -1){
		dist[cur - C] = d
		queue.append(cur - C)
	}
	if(r < R - 1 and wall[cur + C] == 0 and dist[cur + C] == -1){
		dist[cur + C] = d
		queue.append(cur + C)
	}
	if(c > 0 and wall[cur - 1] == 0 and dist[cur - 1] == -1){
		dist[cur - 1] = d
		queue.append(cur - 1)
	}
	if(c < C - 1 and wall[cur + 1] == 0 and dist[cur + 1] == -1){
		dist[cur + 1] = d
		queue.append(cur + 1)
	}
}
[dist[R * C - 1], len(queue)]
